{{!< default}}
{{!-- A page: an article with no date, no reading time and no tags.

It keeps the table of contents. A colophon or an about page is often the longest thing on a
blog, and the rail is the only way back up it. --}}
<div class="with-rail"><main id="content">

{{#post}}
<article class="{{post_class}}">
{{#if @page.show_title_and_feature_image}}
<header>
<h1 class="reading-font mt-2 fs-h1 font-semibold">{{title}}</h1>
</header>
{{/if}}

<div id="post-body" class="prose">{{content}}</div>
<script>quireink.article()</script>
</article>
{{/post}}

</main></div>
